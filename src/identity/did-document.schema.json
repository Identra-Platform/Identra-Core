{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DID Document Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "id"],
  "properties": {
    "@context": {
      "oneOf": [
        { "type": "string", "const": "https://www.w3.org/ns/did/v1" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": { "const": "https://www.w3.org/ns/did/v1" }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9.-_:]+$"
    },
    "alsoKnownAs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "controller": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9.-_:]+$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9.-_:]+$"
          },
          "uniqueItems": true
        }
      ]
    },
    "verificationMethod": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/verificationMethod"
      },
      "uniqueItems": true
    },
    "authentication": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^#?[a-zA-Z0-9.-_:]+$" },
          { "$ref": "#/definitions/verificationMethod" }
        ]
      },
      "uniqueItems": true
    },
    "assertionMethod": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^#?[a-zA-Z0-9.-_:]+$" },
          { "$ref": "#/definitions/verificationMethod" }
        ]
      },
      "uniqueItems": true
    },
    "keyAgreement": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^#?[a-zA-Z0-9.-_:]+$" },
          { "$ref": "#/definitions/verificationMethod" }
        ]
      },
      "uniqueItems": true
    },
    "capabilityInvocation": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^#?[a-zA-Z0-9.-_:]+$" },
          { "$ref": "#/definitions/verificationMethod" }
        ]
      },
      "uniqueItems": true
    },
    "capabilityDelegation": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^#?[a-zA-Z0-9.-_:]+$" },
          { "$ref": "#/definitions/verificationMethod" }
        ]
      },
      "uniqueItems": true
    },
    "service": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/service"
      },
      "uniqueItems": true
    }
  },
  "definitions": {
    "verificationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "controller"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^#?[a-zA-Z0-9.-_:]+$"
        },
        "type": {
          "type": "string"
        },
        "controller": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9.-_:]+$"
        },
        "publicKeyJwk": {
          "type": "object"
        },
        "publicKeyBase58": {
          "type": "string"
        },
        "publicKeyMultibase": {
          "type": "string"
        }
      },
      "oneOf": [
        { "required": ["publicKeyJwk"] },
        { "required": ["publicKeyBase58"] },
        { "required": ["publicKeyMultibase"] }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "serviceEndpoint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^#?[a-zA-Z0-9.-_:]+$"
        },
        "type": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "serviceEndpoint": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            {
              "type": "object",
              "properties": {
                "uri": { "type": "string", "format": "uri" },
                "accept": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "routingKeys": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "accept": {
          "type": "array",
          "items": { "type": "string" }
        },
        "routingKeys": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}